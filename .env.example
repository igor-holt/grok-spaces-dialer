# App-only bearer token for the X API Spaces endpoints.
# Python: export this before running the client or the smoke test.
# Worker:  npx wrangler secret put X_BEARER_TOKEN
# The secret name is exactly X_BEARER_TOKEN. Do not commit a real value.
X_BEARER_TOKEN=

# Not used by the discovery prototype. Phone calling and audio bridging are not built.
# XAI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
